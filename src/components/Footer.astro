---
import { tools, staticPages, toolPath, staticPath } from '../i18n/config.js';
import { t } from '../i18n/ui.js';

const { locale } = Astro.props;
const strings = t(locale);
const year = new Date().getFullYear();

const toolLinks = tools.map((tool) => ({ name: tool.name[locale], href: toolPath(tool.id, locale) }));
const siteLinks = staticPages.map((page) => ({ name: page.nav[locale], href: staticPath(page.id, locale) }));
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h3>{strings.footerToolsHeading}</h3>
        <ul>
          {toolLinks.map((link) => (
            <li><a href={link.href}>{link.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3>{strings.footerSiteHeading}</h3>
        <ul>
          {siteLinks.map((link) => (
            <li><a href={link.href}>{link.name}</a></li>
          ))}
          <li><button type="button" class="footer-link-button" id="cookie-settings">{strings.cookieSettings}</button></li>
        </ul>
      </div>
      <div>
        <h3>Check and Validate</h3>
        <p style="color:var(--color-text-muted);font-size:0.9rem;margin:0;">{strings.footerTagline}</p>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{strings.copyright(year)}</span>
    </div>
  </div>
</footer>
