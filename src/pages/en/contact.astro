---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { alternatesFor, staticPath, homePath } from '../../i18n/config.js';
import { t } from '../../i18n/ui.js';

const locale = 'en';
const strings = t(locale);
const pageId = 'contact';
const path = staticPath(pageId, locale);
const alternates = alternatesFor('static', pageId);

const title = 'Contact | Check and Validate';
const description =
  'How to reach Check and Validate with questions, corrections, or suggestions about the CNP, DNI/NIE, and IBAN validators.';

const schema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: strings.breadcrumbHome, item: new URL(homePath(locale), Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: new URL(path, Astro.site).toString() },
  ],
};
---

<BaseLayout title={title} description={description} locale={locale} path={path} alternates={alternates} schema={schema}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={homePath(locale)}>{strings.breadcrumbHome}</a>
    <span class="sep">&gt;</span>
    <span aria-current="page">Contact</span>
  </nav>

  <h1>Contact</h1>

  <p>
    Check and Validate is run by a small team, and we read every message. The best way to reach us
    is by email at <a href="mailto:contact@checkandvalidate.com">contact@checkandvalidate.com</a>.
  </p>

  <h2>What to get in touch about</h2>
  <p>
    We are glad to hear from you if any of the following applies:
  </p>
  <ul class="prose">
    <li>You think a tool gave a wrong result for a number you know to be valid or invalid.</li>
    <li>Some wording reads awkwardly or incorrectly in English, Romanian, or Spanish.</li>
    <li>A country length, a county code, or another reference detail looks out of date.</li>
    <li>You have an idea for another identity or bank number that would be worth adding.</li>
  </ul>

  <h2>Reporting a wrong result</h2>
  <p>
    If a validator seems to be wrong, please include the exact number you entered (you can change
    a couple of digits if it is a real personal number, as long as the example still shows the
    problem), the tool you used, and what you expected to happen. That makes it much faster for us
    to reproduce and fix the issue.
  </p>

  <h2>Response time</h2>
  <p>
    We usually reply within a few working days. This is a free site maintained in our spare time,
    so we appreciate your patience if it takes a little longer during busy periods.
  </p>
</BaseLayout>
