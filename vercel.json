{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.checkandvalidate.com" }],
      "destination": "https://checkandvalidate.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/",
      "destination": "/en",
      "statusCode": 301
    }
  ]
}
