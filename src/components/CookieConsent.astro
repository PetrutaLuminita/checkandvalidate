---
// Consent banner with a REAL choice, not just a notice. Advertising and analytics
// do not load until the visitor clicks Accept. If they click Reject, neither
// loads and the site keeps working fully, because every validator runs locally
// in the browser. The "Cookie settings" button in the footer reopens this banner
// so the choice can be changed at any time.
//
// The banner is translated per language and links to this language's own
// Privacy Policy with a relative path. It deliberately does not name a specific
// ad vendor.
//
// EEA / UK note: Google requires a certified consent management platform before
// it will serve ads to visitors in those regions, and this banner is not one. Do
// not hand-roll an IAB TCF signal. Before ads go live, add Google's Funding Choices
// at the integration point in BaseLayout.astro <head>.
import { staticPath } from '../i18n/config.js';
import { t } from '../i18n/ui.js';

const { locale } = Astro.props;
const strings = t(locale);
const privacyHref = staticPath('privacy', locale);
---

<div class="cookie-banner" id="cookie-banner" hidden>
  <div class="cookie-banner-inner">
    <p>
      {strings.cookieText}
      <a href={privacyHref}>{strings.cookiePrivacyLink}</a>
    </p>
    <div class="cookie-banner-actions">
      <button class="btn btn-secondary" id="cookie-decline" type="button">{strings.cookieDecline}</button>
      <button class="btn" id="cookie-accept" type="button">{strings.cookieAccept}</button>
    </div>
  </div>
</div>

<script>
  // One consent choice, remembered across the whole site and every language.
  // Values: 'accepted' | 'rejected'. Absence means "not asked yet".
  const STORAGE_KEY = 'cav-cookie-consent';
  const AD_LOADER =
    'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1835532025355533';
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('cookie-accept');
  const declineBtn = document.getElementById('cookie-decline');
  const settingsBtn = document.getElementById('cookie-settings');

  // The ONLY place advertising and analytics are allowed to start. It is called
  // after Accept, or on load for a returning visitor who already accepted. It
  // never runs on Reject or before a choice is made.
  async function loadConsentedScripts() {
    if ((window as any).__cavConsentedLoaded) return; // load at most once
    (window as any).__cavConsentedLoaded = true;

    const adScript = document.createElement('script');
    adScript.async = true;
    adScript.crossOrigin = 'anonymous';
    adScript.src = AD_LOADER;
    document.head.appendChild(adScript);

    // Same setup as @vercel/analytics/astro, which cannot be used here because
    // the component starts collecting as soon as the page renders.
    const { inject, pageview } = await import('@vercel/analytics');
    inject(
      {
        disableAutoTrack: true,
        framework: 'astro',
        basePath: import.meta.env.PUBLIC_VERCEL_OBSERVABILITY_BASEPATH,
      },
      import.meta.env.PUBLIC_VERCEL_OBSERVABILITY_CLIENT_CONFIG
    );
    const path = window.location.pathname;
    pageview({ route: path, path });
  }

  function readConsent() {
    try { return localStorage.getItem(STORAGE_KEY); } catch (e) { return null; /* private mode */ }
  }

  function setConsent(value: string) {
    try { localStorage.setItem(STORAGE_KEY, value); } catch (e) { /* private mode */ }
    if (banner) banner.hidden = true;
  }

  const stored = readConsent();
  if (stored === 'accepted') {
    // Returning visitor who already consented: load without re-asking.
    loadConsentedScripts();
  } else if (stored !== 'rejected') {
    // No choice yet: ask. (If 'rejected', do nothing and load nothing.)
    if (banner) banner.hidden = false;
  }

  acceptBtn?.addEventListener('click', () => {
    setConsent('accepted');
    loadConsentedScripts();
  });
  declineBtn?.addEventListener('click', () => {
    setConsent('rejected');
    // Scripts already running on this page cannot be unloaded, so a visitor who
    // withdraws consent gets a fresh page without them.
    if ((window as any).__cavConsentedLoaded) window.location.reload();
  });
  settingsBtn?.addEventListener('click', () => {
    if (banner) banner.hidden = false;
  });
</script>
