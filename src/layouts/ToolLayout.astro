---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { getTool, toolPath, homePath, alternatesFor } from '../i18n/config.js';
import { t } from '../i18n/ui.js';

const {
  title,
  description,
  locale,
  toolId,
  summary,
  faq = [],
  // Pages can supply their own privacy callout text (e.g. the credit card page
  // uses stronger wording) and ask for a more prominent, emphasized box.
  calloutText,
  calloutEmphasis = false,
} = Astro.props;

const strings = t(locale);
const tool = getTool(toolId);
const toolName = tool.name[locale];
const path = toolPath(toolId, locale);
const alternates = alternatesFor('tool', toolId);
const canonicalURL = new URL(path, Astro.site);
const home = homePath(locale);

// Two-level breadcrumb per the spec: Home > Tool Name, in this language.
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: strings.breadcrumbHome, item: new URL(home, Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: toolName, item: canonicalURL.toString() },
  ],
};

const softwareAppSchema = {
  '@type': 'SoftwareApplication',
  name: toolName,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any (web browser)',
  url: canonicalURL.toString(),
  inLanguage: locale,
  description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};

const faqSchema = faq.length
  ? {
      '@type': 'FAQPage',
      inLanguage: locale,
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;

const schema = [breadcrumbSchema, softwareAppSchema, ...(faqSchema ? [faqSchema] : [])];

// Split the privacy callout so the first sentence reads as a bold lead-in.
// Each language's string starts with a short lead sentence.
const callout = calloutText || strings.privacyCallout;
const [calloutLead, ...calloutRest] = callout.split('. ');
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  path={path}
  alternates={alternates}
  schema={schema}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={home}>{strings.breadcrumbHome}</a>
    <span class="sep">&gt;</span>
    <span aria-current="page">{toolName}</span>
  </nav>

  <h1>{toolName}</h1>
  <p class="tool-summary">{summary}</p>

  <AdSlot position="tool-top" label={strings.adLabel} />

  <div class={`privacy-callout${calloutEmphasis ? ' is-emphasized' : ''}`} role="note">
    <svg class="privacy-callout-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5zm-3 8V7a3 3 0 0 1 6 0v3H9z" fill="currentColor"/>
    </svg>
    <p><strong>{calloutLead}.</strong> {calloutRest.join('. ')}</p>
  </div>

  <slot name="tool" />

  <AdSlot position="tool-result" label={strings.adLabel} />

  <slot name="body" />

  {faq.length > 0 && (
    <section aria-label={strings.faqHeading}>
      <h2>{strings.faqHeading}</h2>
      {faq.map((item) => (
        <div class="faq-item">
          <h3>{item.question}</h3>
          <p set:html={item.answer} />
        </div>
      ))}
    </section>
  )}

  <AdSlot position="tool-bottom" label={strings.adLabel} />

  <RelatedTools current={toolId} locale={locale} />
</BaseLayout>
