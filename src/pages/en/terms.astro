---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { alternatesFor, staticPath, homePath } from '../../i18n/config.js';
import { t } from '../../i18n/ui.js';

const locale = 'en';
const strings = t(locale);
const pageId = 'terms';
const path = staticPath(pageId, locale);
const alternates = alternatesFor('static', pageId);
const lastUpdated = 'July 7, 2026';

const title = 'Terms | Check and Validate';
const description =
  'The simple terms of use for Check and Validate, including the important point that its validators are for information only.';

const schema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: strings.breadcrumbHome, item: new URL(homePath(locale), Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Terms', item: new URL(path, Astro.site).toString() },
  ],
};
---

<BaseLayout title={title} description={description} locale={locale} path={path} alternates={alternates} schema={schema}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={homePath(locale)}>{strings.breadcrumbHome}</a>
    <span class="sep">&gt;</span>
    <span aria-current="page">Terms</span>
  </nav>

  <h1>Terms of Use</h1>
  <p class="disclaimer">Last updated: {lastUpdated}</p>

  <p>
    By using Check and Validate you agree to these terms. They are short and written in plain
    language on purpose.
  </p>

  <h2>The tools are for information only</h2>
  <p>
    The validators on this site check whether an identity or bank number is well formed according
    to its published algorithm. A result of valid means the number is mathematically consistent. It
    is not confirmation that the number was issued, is currently active, or belongs to any
    particular person or account. Do not rely on these tools as the sole basis for a legal,
    financial, or identity decision. Where certainty matters, confirm the number with the issuing
    authority or the relevant bank.
  </p>

  <h2>No warranty</h2>
  <p>
    The site is provided as is, without warranties of any kind. We work to keep the algorithms and
    reference data, such as country IBAN lengths and county codes, accurate and up to date, but we
    cannot guarantee that every result is free of error. To the extent permitted by law, we accept
    no liability for any loss arising from the use of this site.
  </p>

  <h2>Acceptable use</h2>
  <p>
    You may use these tools freely for personal and commercial purposes. You may not use the site
    in a way that breaks the law, attempts to disrupt or overload it, or misrepresents its results
    as an official verification service.
  </p>

  <h2>Advertising</h2>
  <p>
    This site is supported by advertising, including Google AdSense. How advertising cookies work
    and how to control them is explained in our
    <a href={staticPath('privacy', locale)}>Privacy Policy</a>.
  </p>

  <h2>Changes to these terms</h2>
  <p>
    We may update these terms from time to time. The current version is always the one on this
    page, with the "last updated" date shown at the top.
  </p>

  <h2>Contact</h2>
  <p>
    If anything here is unclear, email us at
    <a href="mailto:contact@checkandvalidate.com">contact@checkandvalidate.com</a>.
  </p>
</BaseLayout>
