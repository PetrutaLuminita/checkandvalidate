---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { getTool, toolPath, homePath, alternatesFor } from '../i18n/config.js';
import { t } from '../i18n/ui.js';

const {
  title,
  description,
  locale,
  toolId,
  summary,
  faq = [],
} = Astro.props;

const strings = t(locale);
const tool = getTool(toolId);
const toolName = tool.name[locale];
const path = toolPath(toolId, locale);
const alternates = alternatesFor('tool', toolId);
const canonicalURL = new URL(path, Astro.site);
const home = homePath(locale);

// Two-level breadcrumb per the spec: Home > Tool Name, in this language.
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: strings.breadcrumbHome, item: new URL(home, Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: toolName, item: canonicalURL.toString() },
  ],
};

const softwareAppSchema = {
  '@type': 'SoftwareApplication',
  name: toolName,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any (web browser)',
  url: canonicalURL.toString(),
  inLanguage: locale,
  description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};

const faqSchema = faq.length
  ? {
      '@type': 'FAQPage',
      inLanguage: locale,
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;

const schema = [breadcrumbSchema, softwareAppSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  path={path}
  alternates={alternates}
  schema={schema}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={home}>{strings.breadcrumbHome}</a>
    <span class="sep">&gt;</span>
    <span aria-current="page">{toolName}</span>
  </nav>

  <h1>{toolName}</h1>
  <p class="tool-summary">{summary}</p>

  <AdSlot position="tool-top" label={strings.adLabel} />

  <slot name="tool" />

  <AdSlot position="tool-result" label={strings.adLabel} />

  <slot name="body" />

  {faq.length > 0 && (
    <section aria-label={strings.faqHeading}>
      <h2>{strings.faqHeading}</h2>
      {faq.map((item) => (
        <div class="faq-item">
          <h3>{item.question}</h3>
          <p set:html={item.answer} />
        </div>
      ))}
    </section>
  )}

  <AdSlot position="tool-bottom" label={strings.adLabel} />

  <RelatedTools current={toolId} locale={locale} />
</BaseLayout>
