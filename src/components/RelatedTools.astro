---
import { relatedTools } from '../i18n/config.js';
import { t } from '../i18n/ui.js';

const { current, locale } = Astro.props;
const strings = t(locale);
// Link to every other tool on the site in this language.
const related = relatedTools(current, locale, 20);
---

<section class="related-tools" aria-label={strings.relatedHeading}>
  <h2>{strings.relatedHeading}</h2>
  <ul>
    {related.map((tool) => (
      <li>
        <a href={tool.href}>{tool.name}</a>
      </li>
    ))}
  </ul>
</section>
